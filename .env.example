# ==========================
# Django
# ==========================
SECRET_KEY=
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1,forjageek.space,www.forjageek.space
# Em produção, use DEBUG=False. As proteções HTTPS serão ativadas automaticamente.
SECURE_HSTS_SECONDS=31536000

# ==========================
# Banco de dados
# ==========================
NEON_DATABASE_URL=
# Opcional durante a troca de banco: quando preenchida, esta variável tem prioridade.
NEON_DATABASE_URL_NOVA=
FORJAGEEK_USE_SQLITE=false

# O padrão local usa pastas dentro do projeto. Em produção, os padrões são
# /var/www/forjageek/static e /var/www/forjageek/media.
STATIC_ROOT=
MEDIA_ROOT=

# ==========================
# Google Gemini
# ==========================
GEMINI_API_KEY=
GEMINI_MODEL=

# Opcional: sem esta chave, a busca por código de barras usa o plano de teste do UPCitemdb.
UPCITEMDB_USER_KEY=

# ==========================
# Stripe
# ==========================
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
# ==========================
# Twilio (WhatsApp Verify)
# ==========================
TWILIO_ACCOUNT_SID=cole_seu_account_sid_aqui
TWILIO_AUTH_TOKEN=cole_seu_auth_token_aqui
TWILIO_VERIFY_SERVICE_SID=cole_seu_verify_service_sid_aqui

# ==========================
# E-mail SMTP
# ==========================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.seu-provedor.com
EMAIL_PORT=587
EMAIL_HOST_USER=seu-email@exemplo.com
EMAIL_HOST_PASSWORD=SUA_SENHA_DE_APLICATIVO
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=ForjaGeek <seu-email@exemplo.com>

# ==========================
# Chatgpt
# ==========================
CHATGPT_API_KEY=

# ==========================
# Geração de dioramas com OpenAI
# ==========================
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
